"use client";

import { use } from "react";
import { notFound } from "next/navigation";
import dynamic from "next/dynamic";
import { motion } from "framer-motion";
import { clientsData } from "@/data/mockStudio";

const MapComponent = dynamic(() => import("@/components/Map"), { ssr: false });

export default function CenterPage({ params }: { params: Promise<{ center: string }> }) {
  // التعديل الجديد: فك تشفير الرابط باستخدام use
  const unwrappedParams = use(params);
  const clientKey = unwrappedParams.center.toLowerCase();
  const client = clientsData[clientKey];

  if (!client) return notFound();

  const handleBooking = (serviceName: string) => {
    const message = `مرحباً، أريد حجز موعد لخدمة: ${serviceName}`;
    window.open(`https://wa.me/${client.whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
  };

  return (
    <div className="min-h-screen bg-neutral-950 text-white font-sans selection:bg-neutral-800 pb-20">
      
      <motion.header 
        initial={{ opacity: 0, y: -20 }}
        animate={{ opacity: 1, y: 0 }}
        className="w-full p-6 flex justify-center border-b border-neutral-900 bg-neutral-950/80 backdrop-blur-md sticky top-0 z-50"
      >
        <h1 style={{ color: client.themeColor }} className="text-3xl font-extrabold tracking-tight">
          {client.name}
        </h1>
      </motion.header>

      <main className="max-w-2xl mx-auto p-4 flex flex-col gap-10 mt-6">
        
        <div className="text-center">
          <h2 className="text-xl text-neutral-300">{client.heroMessage}</h2>
        </div>
        
        <div className="flex flex-col gap-4">
          <h3 className="text-lg font-bold text-neutral-400 mb-2">اختر الخدمة:</h3>
          {client.services.map((service, index) => (
            <motion.div 
              key={service.id}
              initial={{ opacity: 0, x: -20 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ delay: index * 0.1 }}
              className="bg-neutral-900 border border-neutral-800 p-5 rounded-2xl flex flex-col gap-4 hover:border-neutral-700 transition-all"
            >
              <div className="flex justify-between items-start">
                <div>
                  <h4 className="text-lg font-bold text-white flex items-center gap-2">
                    {service.name}
                    {service.badge && (
                      <span className="text-xs bg-yellow-500/10 text-yellow-500 px-2 py-1 rounded-md">
                        {service.badge}
                      </span>
                    )}
                  </h4>
                  <p className="text-sm text-neutral-400 mt-1">{service.desc}</p>
                </div>
                <div className="text-left shrink-0">
                  <p className="text-lg font-bold" style={{ color: client.themeColor }}>
                    {service.priceFormatted}
                  </p>
                  <p className="text-xs text-neutral-500">{service.duration}</p>
                </div>
              </div>

              <button 
                onClick={() => handleBooking(service.name)}
                className="w-full py-3 rounded-xl font-bold text-black transition-transform active:scale-95 mt-2"
                style={{ backgroundColor: client.themeColor }}
              >
                تأكيد الحجز عبر واتساب
              </button>
            </motion.div>
          ))}
        </div>

        <div className="flex flex-col gap-4">
          <h3 className="text-lg font-bold text-neutral-400">موقعنا:</h3>
          <div className="w-full h-64 bg-neutral-900 rounded-2xl border border-neutral-800 overflow-hidden relative">
            <MapComponent coordinates={client.mapCoordinates} name={client.name} />
          </div>
        </div>

      </main>
    </div>
  );
}
